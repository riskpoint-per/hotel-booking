{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/api",
      "env": {
        "DATABASE_URL": "postgres://hotel:hotel@localhost:5432/hotel?sslmode=disable",
        "EMAIL_DELAY_SECONDS": "2"
      }
    },
    {
      "name": "Debug unit tests (service)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/internal/service"
    },
    {
      "name": "Debug integration tests (repository)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/internal/repository",
      "env": {
        "TEST_DATABASE_URL": "postgres://hotel:hotel@localhost:5432/hotel?sslmode=disable"
      },
      "args": ["-test.count=1", "-test.v"]
    }
  ]
}
